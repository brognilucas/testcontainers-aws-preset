{
  "name": "testcontainers-aws-preset",
  "version": "0.1.0",
  "description": "Testcontainers preset for AWS services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:integration": "RUN_INTEGRATION=1 jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "testcontainers",
    "aws",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.996.0",
    "@aws-sdk/client-eventbridge": "^3.996.0",
    "@aws-sdk/client-s3": "^3.996.0",
    "@aws-sdk/client-sns": "^3.996.0",
    "@aws-sdk/client-sqs": "^3.996.0",
    "@aws-sdk/util-dynamodb": "^3.996.0",
    "@testcontainers/localstack": "^11.12.0",
    "testcontainers": "^11.12.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  }
}
